APP_NAME=TankWar OJ
APP_ENV=dev
SECRET_KEY=replace-me
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///backend/runtime/tankwar.db

SESSION_COOKIE_SECURE=0
SESSION_TTL_SECONDS=86400
PASSWORD_TOKEN_TTL_SECONDS=86400

WORKER_POLL_INTERVAL_SECONDS=2.0
MAX_MATCH_WORKERS=2
ENABLE_WORKERS=1

COMPILE_TIMEOUT_SECONDS=20
RUN_TIMEOUT_SECONDS=1.0
RUN_MEMORY_LIMIT_MB=256
ENABLE_PROCESS_LIMITS=0
MAX_RUNTIME_OUTPUT_BYTES=65536
MAX_COMPILE_LOG_BYTES=262144
MAX_SOURCE_SIZE_BYTES=1048576
MAX_EXECUTABLE_SIZE_BYTES=1048576
MIN_SUBMISSION_INTERVAL_SECONDS=60
