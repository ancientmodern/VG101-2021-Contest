<!DOCTYPE html>
<html lang="en" class="site page--profile">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>My Settings - TankWar Lab</title>
</head>
<body>
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li id="signin">
                    <a href="/profile" class="nav__item active"><%= realName || studentId %></a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<%
    var compilers = [
        ["c++98", "GNU C++ 8.3.0 (-O3 -std=c++98)"],
        ["c++11", "GNU C++ 8.3.0 (-O3 -std=c++11)"],
        ["c++14", "GNU C++ 8.3.0 (-O3 -std=c++14)"],
        ["c++17", "GNU C++ 8.3.0 (-O3 -std=c++17)"]
    ];
%>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <header class="tw-head">
                <div>
                    <p class="tw-head__eyebrow">Account</p>
                    <h1 class="tw-head__title">Settings</h1>
                </div>
            </header>
            <div class="tw-layout">
                <div class="tw-layout__main">
                    <% if (post) { %>
                        <p class="tw-alert tw-alert--ok" role="status">
                            <strong>Settings saved.</strong>
                        </p>
                    <% } %>
                    <section class="tw-card" aria-labelledby="compilerTitle">
                        <div class="tw-card__head">
                            <h2 class="tw-card__title" id="compilerTitle">Compiler</h2>
                        </div>
                        <div class="tw-card__body">
                            <form method="post" action="/profile/settings" class="tw-form">
                                <div class="tw-field">
                                    <label class="tw-label" for="compiler">Default compiler</label>
                                    <select class="tw-select" id="compiler" name="compiler">
                                        <% compilers.forEach(function (c) { %>
                                            <option value="<%= c[0] %>" <% if (compiler === c[0]) { %>selected<% } %>><%= c[1] %></option>
                                        <% }) %>
                                    </select>
                                    <p class="tw-help">Saved with your account. The submit form always starts on C++17 for now, so
                                        pick the compiler there too.</p>
                                </div>
                                <input type="hidden" name="_csrf" value="">
                                <div class="tw-actions">
                                    <button class="tw-btn" type="submit">Save settings</button>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>

                <aside class="tw-layout__side">
                    <nav class="tw-card tw-side tw-side--menu" aria-label="Account">
                        <ol class="tw-menu">
                            <li>
                                <a href="/profile" class="tw-menu__link">My profile</a>
                            </li>
                            <li>
                                <a href="/profile/settings" class="tw-menu__link" aria-current="page">Settings</a>
                            </li>
                            <li class="tw-menu__sep" role="separator"></li>
                            <li>
                                <a href="/logout" class="tw-menu__link">Log out</a>
                            </li>
                        </ol>
                    </nav>
                </aside>
            </div>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
</body>
</html>
