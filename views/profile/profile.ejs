<!DOCTYPE html>
<html lang="en" class="site page--profile">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>My Profile - TankWar Lab</title>
</head>
<body>
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li id="signin">
                    <a href="/profile" class="nav__item active" aria-current="page"><%= realName || studentId %></a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <header class="tw-head">
                <div>
                    <p class="tw-head__eyebrow">Account</p>
                    <h1 class="tw-head__title">My profile</h1>
                </div>
            </header>
            <div class="tw-layout">
                <div class="tw-layout__main">
                    <% if (post) { %>
                        <% if (wrongPassword) { %>
                            <p class="tw-alert tw-alert--error" role="alert">
                                <strong>Current password is incorrect.</strong> Nothing was changed; your password
                                is still the old one.
                            </p>
                        <% } else { %>
                            <p class="tw-alert tw-alert--ok" role="status">
                                <strong>Changes saved.</strong>
                            </p>
                        <% } %>
                    <% } %>

                    <section class="tw-card" aria-labelledby="publicTitle">
                        <div class="tw-card__head">
                            <h2 class="tw-card__title" id="publicTitle">Public profile</h2>
                            <span class="tw-card__hint">What other players see</span>
                        </div>
                        <div class="tw-card__body">
                            <form method="post" action="/profile" class="tw-form" id="profileForm">
                                <dl class="tw-readonly">
                                    <dt>Student ID</dt>
                                    <dd><%= studentId %></dd>
                                    <dt>Real name</dt>
                                    <dd><%= realName %> <span class="tw-help">(only TAs can see this)</span></dd>
                                </dl>
                                <div class="tw-field">
                                    <label class="tw-label" for="name">Display name</label>
                                    <input type="text" id="name" name="name" class="tw-input" value="<%= dispName %>"
                                           required="" autocomplete="nickname">
                                    <p class="tw-help">Shown publicly on the scoreboard and the match list.</p>
                                </div>
                                <div class="tw-skin">
                                    <div class="tw-field">
                                        <label class="tw-label" for="tskin">Tank skin</label>
                                        <input type="text" inputmode="url" spellcheck="false" id="tskin" name="tskin" class="tw-input" value="<%= tankSkin %>"
                                               placeholder="https://&hellip;/tank.png" data-preview="tskinPreview">
                                        <p class="tw-help">Link to an image of your tank facing up. Leave empty for
                                            the default tank.</p>
                                    </div>
                                    <div class="tw-skin__preview" id="tskinPreview" aria-live="polite"></div>
                                </div>
                                <div class="tw-skin">
                                    <div class="tw-field">
                                        <label class="tw-label" for="bskin">Bullet skin</label>
                                        <input type="text" inputmode="url" spellcheck="false" id="bskin" name="bskin" class="tw-input" value="<%= bulletSkin %>"
                                               placeholder="https://&hellip;/bullet.png" data-preview="bskinPreview">
                                        <p class="tw-help">Link to an image of your bullet facing up. Leave empty for
                                            the default bullet.</p>
                                    </div>
                                    <div class="tw-skin__preview" id="bskinPreview" aria-live="polite"></div>
                                </div>
                                <input type="hidden" name="_csrf" value="">
                                <div class="tw-actions">
                                    <button class="tw-btn" type="submit">Save profile</button>
                                </div>
                            </form>
                        </div>
                    </section>

                    <section class="tw-card" aria-labelledby="passwordTitle">
                        <div class="tw-card__head">
                            <h2 class="tw-card__title" id="passwordTitle">Change password</h2>
                        </div>
                        <div class="tw-card__body">
                            <form method="post" action="/profile" class="tw-form" id="passwordForm">
                                <%# The server updates the display name together with the password. %>
                                <input type="hidden" name="name" value="<%= dispName %>">
                                <input type="text" name="username" value="<%= studentId %>" autocomplete="username"
                                       hidden aria-hidden="true" tabindex="-1">
                                <div class="tw-field">
                                    <label class="tw-label" for="password">Current password</label>
                                    <input type="password" id="password" name="password" class="tw-input" required=""
                                           autocomplete="current-password">
                                </div>
                                <div class="tw-field" id="newPasswordField">
                                    <label class="tw-label" for="newpassword">New password</label>
                                    <input type="password" id="newpassword" name="newpassword" class="tw-input"
                                           required="" autocomplete="new-password">
                                </div>
                                <input type="hidden" name="_csrf" value="">
                                <div class="tw-actions">
                                    <button class="tw-btn tw-btn--quiet" type="submit">Change password</button>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>

                <aside class="tw-layout__side">
                    <nav class="tw-card tw-side tw-side--menu" aria-label="Account">
                        <ol class="tw-menu">
                            <li>
                                <a href="/profile" class="tw-menu__link" aria-current="page">My profile</a>
                            </li>
                            <li>
                                <a href="/profile/settings" class="tw-menu__link">Settings</a>
                            </li>
                            <li class="tw-menu__sep" role="separator"></li>
                            <li>
                                <a href="/logout" class="tw-menu__link">Log out</a>
                            </li>
                        </ol>
                    </nav>
                </aside>
            </div>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
<script src="/js/jsUtils/jsUtils.js"></script>
<script>
    require(["jquery", "/js/security/hash"], function ($, hash) {
        // Passwords are hashed in the browser before they are sent, as before.
        $("#passwordForm").on("submit", function () {
            var pwd = $("[name=password]");
            var npwd = $("[name=newpassword]");
            if (pwd.val() && npwd.val()) {
                pwd.val(hash.SHA256(pwd.val()));
                npwd.val(hash.SHA256(npwd.val()));
            }
        });

        // Skin previews. The URL only ever goes into an <img> src attribute.
        $("[data-preview]").each(function () {
            var input = $(this);
            var box = $("#" + input.attr("data-preview"));
            var fallback = input.attr("name") === "tskin" ? "Default tank" : "Default bullet";

            function update() {
                var url = $.trim(input.val());
                box.removeClass("is-broken").empty();
                if (!url) {
                    box.text(fallback);
                    return;
                }
                var img = $("<img>").attr("alt", "Preview").on("error", function () {
                    box.addClass("is-broken").empty().text("Can't load image");
                });
                img.attr("src", url);
                box.append(img);
            }

            var timer;
            input.on("input change", function () {
                clearTimeout(timer);
                timer = setTimeout(update, 300);
            });
            update();
        });
    });
</script>
</body>
</html>
