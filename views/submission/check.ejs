<!DOCTYPE html>
<html lang="en" class="site page--submissions">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>Submission Details - TankWar Lab</title>
</head>
<body>
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item active" aria-current="page">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li id="signin">
                    <a href="/profile" class="nav__item"><%= realName || "My profile" %></a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<%
    // submission.status: -1 pending, 0 effective, 1 inactive, 2 compile error
    var STATUS = {
        "-1": {text: "Pending", badge: "wait", note: "Still compiling. Refresh this page in a minute."},
        "0": {text: "Effective", badge: "win", note: "Compiled. This is the brain that plays your matches now."},
        "1": {text: "Inactive", badge: "wait", note: "Compiled, but a newer brain has replaced it in matches."},
        "2": {text: "Compile error", badge: "lose", note: "This brain didn't compile, so it never played. Fix the errors below and submit again."}
    };
    var st = STATUS[String(submission.status)] || {text: "Unknown", badge: "wait", note: ""};
    var t = new Date(submission.time);
    function p(n) { return (n < 10 ? "0" : "") + n; }
    var when = isNaN(t) ? "Unknown" : t.getFullYear() + "-" + p(t.getMonth() + 1) + "-" + p(t.getDate()) + " " + p(t.getHours()) + ":" + p(t.getMinutes());
%>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <header class="tw-head">
                <div>
                    <p class="tw-head__eyebrow"><a class="tw-link" href="/submission">&larr; My submissions</a></p>
                    <h1 class="tw-head__title">Submission details</h1>
                </div>
            </header>
            <div class="tw-layout">
                <div class="tw-layout__main">
                    <section class="tw-card" aria-labelledby="resultTitle">
                        <div class="tw-card__head">
                            <h2 class="tw-card__title tw-status-line" id="resultTitle">
                                <span class="tw-badge tw-badge--<%= st.badge %> submission-status--text"><%= st.text %></span>
                                <span>Compiler output</span>
                            </h2>
                        </div>
                        <div class="tw-card__body" id="errorMsg">
                            <p><%= st.note %></p>
                            <% if (submission.status === 2) { %>
                                <pre class="tw-output"><%= submission.stack %></pre>
                            <% } else { %>
                                <p class="tw-output tw-output--empty">No compiler output is kept for submissions that
                                    compile.</p>
                            <% } %>
                        </div>
                    </section>
                </div>

                <aside class="tw-layout__side">
                    <nav class="tw-card tw-side tw-side--menu" aria-label="Submission">
                        <p class="tw-menu__title">Submission</p>
                        <ol class="tw-menu">
                            <li><a href="/submission" class="tw-menu__link" aria-current="page">My submissions</a></li>
                            <li><a href="/submission/O1" class="tw-menu__link">Task 1 results</a></li>
                            <li><a href="/submission/submit" class="tw-menu__link">Submit new brain</a></li>
                        </ol>
                    </nav>
                </aside>
                <aside class="tw-layout__side--after">
                    <section class="tw-card tw-side" aria-labelledby="infoTitle">
                        <p class="tw-menu__title" id="infoTitle">Submission info</p>
                        <dl class="tw-facts">
                            <dt>Status</dt>
                            <dd data-id="submission_status"><%= st.text %></dd>
                            <dt>Submitted</dt>
                            <dd><span class="time"><%= when %></span></dd>
                            <dt>Compiler</dt>
                            <dd id="compiler"><%= submission.compiler || "Unknown" %></dd>
                        </dl>
                    </section>
                </aside>
            </div>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
<script src="/js/jQuery.js"></script>
</body>
</html>
