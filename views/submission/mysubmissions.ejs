<!DOCTYPE html>
<html lang="en" class="site page--submissions">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>My Submissions - TankWar Lab</title>
</head>
<body>
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item active" aria-current="page">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li id="signin">
                    <a href="/profile" class="nav__item"><%= realName || "My profile" %></a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<%
    // submission.status: -1 pending, 0 effective, 1 inactive, 2 compile error
    var STATUS = {
        "-1": {text: "Pending", badge: "wait"},
        "0": {text: "Effective", badge: "win"},
        "1": {text: "Inactive", badge: "wait"},
        "2": {text: "Compile error", badge: "lose"}
    };
    function statusOf(s) {
        return STATUS[String(s)] || {text: "Unknown", badge: "wait"};
    }
    function iso(t) {
        var d = new Date(t);
        return isNaN(d) ? "" : d.toISOString();
    }
    function when(t) {
        var d = new Date(t);
        if (isNaN(d)) return "Unknown";
        function p(n) { return (n < 10 ? "0" : "") + n; }
        return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + " " + p(d.getHours()) + ":" + p(d.getMinutes());
    }
%>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <header class="tw-head">
                <div>
                    <p class="tw-head__eyebrow">Submission</p>
                    <h1 class="tw-head__title">My submissions</h1>
                </div>
            </header>
            <div class="tw-layout">
                <div class="tw-layout__main">
                    <section class="tw-card" aria-labelledby="listTitle">
                        <div class="tw-card__head">
                            <h2 class="tw-card__title" id="listTitle">Brains you've submitted</h2>
                            <span class="tw-card__hint">Your newest brain that compiles is <b>Effective</b> and plays
                                matches; older ones become <b>Inactive</b>.</span>
                        </div>
                        <% if (submissions.length === 0) { %>
                            <div class="tw-empty">
                                <p class="tw-empty__title">No submissions yet</p>
                                <p class="tw-empty__text">Submit your brain's C++ source and the judge will compile it
                                    and start scheduling matches.</p>
                                <a class="tw-btn" href="/submission/submit">Submit a brain</a>
                            </div>
                        <% } else { %>
                            <div class="tw-table-scroll">
                                <table class="tw-table submissions-table">
                                    <thead>
                                    <tr>
                                        <th scope="col">Status</th>
                                        <th scope="col">Submitted</th>
                                        <th scope="col">Compiler</th>
                                        <th class="tw-go" scope="col"><span class="tw-sr">Details</span></th>
                                    </tr>
                                    </thead>
                                    <tbody id="datagrid">
                                    <% submissions.forEach((submission) => { var st = statusOf(submission.status); %>
                                        <tr>
                                            <td><span class="tw-badge tw-badge--<%= st.badge %>"><%= st.text %></span></td>
                                            <td class="tw-time">
                                                <time datetime="<%= iso(submission.time) %>"><%= when(submission.time) %></time>
                                            </td>
                                            <td><%= submission.compiler %></td>
                                            <td class="tw-go">
                                                <a class="tw-link" href="/submission/check/<%= submission._id %>">Details &rarr;</a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </section>
                </div>

                <aside class="tw-layout__side">
                    <nav class="tw-card tw-side tw-side--menu" aria-label="Submission">
                        <p class="tw-menu__title">Submission</p>
                        <ol class="tw-menu">
                            <li><a href="/submission" class="tw-menu__link" aria-current="page">My submissions</a></li>
                            <li><a href="/submission/O1" class="tw-menu__link">Task 1 results</a></li>
                            <li><a href="/submission/submit" class="tw-menu__link">Submit new brain</a></li>
                        </ol>
                    </nav>
                </aside>
            </div>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
<script src="/js/jsUtils/jsUtils.js"></script>
</body>
</html>
