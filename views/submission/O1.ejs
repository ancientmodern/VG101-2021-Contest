<!DOCTYPE html>
<html lang="en" class="site page--submissions">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>Task 1 Results - TankWar Lab</title>
</head>
<body>
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item active" aria-current="page">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li id="signin">
                    <a href="/profile" class="nav__item"><%= realName || "My profile" %></a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<%
    // Task 1 judge status codes (core/judge.js).
    var JUDGE = ["Waiting", "Fetched", "Compiling", "Judging", "Accepted", "Wrong answer",
        "Time limit exceeded", "Memory limit exceeded", "Runtime error", "Compile error", "System error"];
    function judgeText(s) {
        return JUDGE[s] || "Unknown";
    }
    function judgeBadge(s) {
        if (s < 4) return "wait";
        if (s === 4) return "win";
        if (s === 10) return "draw";
        return "lose";
    }
%>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <header class="tw-head">
                <div>
                    <p class="tw-head__eyebrow">Submission</p>
                    <h1 class="tw-head__title">Task 1 results</h1>
                    <p class="tw-head__lede">Your latest brain sent to the Task 1 judge, run against each test case.</p>
                </div>
            </header>
            <div class="tw-layout">
                <div class="tw-layout__main">
                    <% if (nosubmission) { %>
                        <section class="tw-card">
                            <div class="tw-empty">
                                <p class="tw-empty__title">Nothing sent to the Task 1 judge yet</p>
                                <p class="tw-empty__text">When you submit a brain, tick <b>Also send to the Task 1
                                        judge</b>. Its results show up here.</p>
                                <a class="tw-btn" href="/submission/submit">Submit a brain</a>
                            </div>
                        </section>
                    <% } else { %>
                        <section class="tw-card" aria-labelledby="scoreTitle">
                            <div class="tw-card__head">
                                <h2 class="tw-card__title tw-status-line" id="scoreTitle">
                                    <span class="tw-badge tw-badge--<%= judgeBadge(submission.status) %> submission-status--text"><%= judgeText(submission.status) %></span>
                                    <span>Latest Task 1 run</span>
                                </h2>
                                <p class="tw-score" aria-label="Score <%= score %> out of 100">
                                    <span class="tw-pixel"><%= score %></span><span class="tw-score__max">/ 100</span>
                                </p>
                            </div>
                            <% if (submission.status === 9) { %>
                                <div class="tw-card__body">
                                    <p>Your brain didn't compile, so no test case ran. Fix the errors below and submit again.</p>
                                    <pre class="tw-output"><%= submission.stderr %></pre>
                                </div>
                            <% } else if (submission.status >= 4 && submission.testcases) { %>
                                <div class="tw-table-scroll">
                                    <table class="tw-table submissions-table">
                                        <thead>
                                        <tr>
                                            <th scope="col">Test case</th>
                                            <th scope="col">Result</th>
                                            <th scope="col">Compiler</th>
                                            <th class="tw-go" scope="col"><span class="tw-sr">Output</span></th>
                                        </tr>
                                        </thead>
                                        <tbody id="datagrid">
                                        <% submission.testcases.forEach((testcase, index) => { %>
                                            <tr>
                                                <td class="tw-time">#<%= index + 1 %></td>
                                                <td><span class="tw-badge tw-badge--<%= judgeBadge(testcase.status) %>"><%= judgeText(testcase.status) %></span></td>
                                                <td><%= submission.compiler %></td>
                                                <td class="tw-go">
                                                    <a class="tw-link" href="/submission/O1/<%= index %>">Output &rarr;</a>
                                                </td>
                                            </tr>
                                        <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else if (submission.status >= 4) { %>
                                <div class="tw-card__body">
                                    <p>The judge stopped before running any test case.</p>
                                    <% if (submission.stderr) { %>
                                        <pre class="tw-output"><%= submission.stderr %></pre>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <div class="tw-card__body">
                                    <p class="tw-output tw-output--empty">The judge is still working on it. Refresh this
                                        page in a minute.</p>
                                </div>
                            <% } %>
                        </section>
                    <% } %>
                </div>

                <aside class="tw-layout__side">
                    <nav class="tw-card tw-side tw-side--menu" aria-label="Submission">
                        <p class="tw-menu__title">Submission</p>
                        <ol class="tw-menu">
                            <li><a href="/submission" class="tw-menu__link">My submissions</a></li>
                            <li><a href="/submission/O1" class="tw-menu__link" aria-current="page">Task 1 results</a></li>
                            <li><a href="/submission/submit" class="tw-menu__link">Submit new brain</a></li>
                        </ol>
                    </nav>
                </aside>
            </div>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
<script src="/js/jsUtils/jsUtils.js"></script>
</body>
</html>
