<!DOCTYPE html>
<html lang="en" class="site page--login">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>Sign in - TankWar Lab</title>
</head>
<body>
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li>
                    <a href="/oauth" class="nav__item active" aria-current="page">Login</a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <section class="tw-card tw-auth" aria-labelledby="authTitle">
                <div class="tw-card__body">
                    <span class="tw-auth__mark" aria-hidden="true">PLAYER LOGIN</span>
                    <h1 class="tw-auth__title" id="authTitle">Sign in</h1>
                    <p class="tw-auth__lede">Use your student ID. Signing in for the first time creates your account,
                        and the password you enter becomes its password.</p>
                    <% if (fail) { %>
                        <p class="tw-alert tw-alert--error" role="alert">
                            <strong>Wrong password for this login ID.</strong> Try again, or reset it below.
                        </p>
                    <% } else if (nouser) { %>
                        <p class="tw-alert tw-alert--error" role="alert">
                            <strong>This login ID isn't on the course list.</strong> Check the ID, or ask a TA to add you.
                        </p>
                    <% } %>
                    <form method="post" action="/oauth" class="tw-form">
                        <div class="tw-field">
                            <label class="tw-label" for="studentId">Login ID</label>
                            <input type="text" id="studentId" name="studentId" class="tw-input" required=""
                                   autocomplete="username" autocapitalize="off" spellcheck="false" autofocus>
                        </div>
                        <div class="tw-field">
                            <label class="tw-label" for="password">Password</label>
                            <input type="password" id="password" name="password" class="tw-input" required=""
                                   autocomplete="current-password">
                        </div>
                        <input type="hidden" name="_csrf" value="<%= CSRF %>">
                        <button class="tw-btn tw-btn--block" type="submit">Sign in</button>
                    </form>
                    <p class="tw-auth__foot">Forgot your password? <a class="tw-link" href="/forgetPassword">Reset it</a></p>
                </div>
            </section>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
<script src="/js/jsUtils/jsUtils.js"></script>
<script src="/js/login.js"></script>
</body>
</html>
