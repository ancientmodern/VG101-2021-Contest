<!DOCTYPE html>
<html lang="en" class="site page--login">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>Reset password - TankWar Lab</title>
</head>
<body>
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li>
                    <a href="/oauth" class="nav__item">Login</a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <section class="tw-card tw-auth" aria-labelledby="authTitle">
                <div class="tw-card__body">
                    <span class="tw-auth__mark" aria-hidden="true">CONTINUE?</span>
                    <h1 class="tw-auth__title" id="authTitle">Reset password</h1>
                    <p class="tw-auth__lede">Enter your login ID and the new password you want. You'll get a reset
                        code: send it to a TA, and they'll switch your account to the new password.</p>
                    <% if (status.success) { %>
                        <div class="tw-alert tw-alert--ok" role="status">
                            <strong>Your reset code</strong>
                            <code class="tw-reset-code"><%= token %></code>
                            Send this code to a TA. Your old password keeps working until they apply it.
                        </div>
                    <% } else if (status.nouser) { %>
                        <p class="tw-alert tw-alert--error" role="alert">
                            <strong>No account uses this login ID.</strong> Check the ID. If you've never signed in,
                            just <a class="tw-link" href="/oauth">sign in</a>: the first sign-in sets your password.
                        </p>
                    <% } %>
                    <form method="post" action="/forgetPassword" class="tw-form">
                        <div class="tw-field">
                            <label class="tw-label" for="studentId">Login ID</label>
                            <input type="text" id="studentId" name="studentId" class="tw-input" required=""
                                   autocomplete="username" autocapitalize="off" spellcheck="false">
                        </div>
                        <div class="tw-field">
                            <label class="tw-label" for="password">New password</label>
                            <input type="password" id="password" name="password" class="tw-input" required=""
                                   autocomplete="new-password">
                        </div>
                        <input type="hidden" name="_csrf" value="<%= CSRF %>">
                        <button class="tw-btn tw-btn--block" type="submit">Get reset code</button>
                    </form>
                    <p class="tw-auth__foot">Remembered it? <a class="tw-link" href="/oauth">Back to sign in</a></p>
                </div>
            </section>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
<script src="/js/jsUtils/jsUtils.js"></script>
<script src="/js/login.js"></script>
</body>
</html>
