<!DOCTYPE html>
<html lang="en" class="site page--login">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/general.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
    <title>Create account - TankWar Lab</title>
</head>
<body>
<!-- Not rendered by any route (guest registration was never enabled); kept
     in the site style in case it is. It still uses the old {{ }} syntax. -->
<nav class="nav" aria-label="Main">
    <div class="row">
        <div class="column nav__container">
            <ol class="nav__container-item">
                <li>
                    <a href="/" class="nav__logo">TankWarJudge</a>
                </li>
                <li>
                    <a href="/" class="nav__item">Scoreboard</a>
                </li>
                <li>
                    <a href="/submission" class="nav__item">Submission</a>
                </li>
                <li>
                    <a href="/match" class="nav__item">Match</a>
                </li>
                <li>
                    <a href="/rules" class="nav__item">Rules</a>
                </li>
            </ol>
            <ol class="nav__container-item">
                <li id="signin">
                    <a href="/oauth" class="nav__item">Login</a>
                </li>
            </ol>
        </div>
    </div>
</nav>
<div class="slideout-panel" id="panel">
    <main class="tw-main">
        <div class="tw-wrap">
            <section class="tw-card tw-auth" aria-labelledby="authTitle">
                <div class="tw-card__body">
                    <span class="tw-auth__mark" aria-hidden="true">NEW PLAYER</span>
                    <h1 class="tw-auth__title" id="authTitle">Create a guest account</h1>
                    <p class="tw-auth__lede">Students on the course list don't need this: sign in with your student ID.</p>
                    {{if fail == 1}}
                    <p class="tw-alert tw-alert--error" role="alert">
                        <strong>That login ID is taken.</strong> Pick another one.
                    </p>
                    {{else if fail == 2}}
                    <p class="tw-alert tw-alert--error" role="alert">
                        <strong>You're on the course list.</strong> <a class="tw-link" href="/oauth">Sign in</a> with your student ID instead.
                    </p>
                    {{/if}}
                    <form method="post" action="/oauth/register" class="tw-form">
                        <div class="tw-field">
                            <label class="tw-label" for="studentId">Login ID</label>
                            <input type="text" id="studentId" name="studentId" class="tw-input" autofocus="" required="">
                        </div>
                        <div class="tw-field">
                            <label class="tw-label" for="realname">Real name</label>
                            <input type="text" id="realname" name="realname" class="tw-input" required="">
                            <p class="tw-help">Only TAs can see your real name.</p>
                        </div>
                        <div class="tw-field">
                            <label class="tw-label" for="name">Display name</label>
                            <input type="text" id="name" name="name" class="tw-input" required="">
                            <p class="tw-help">Shown publicly on the scoreboard and match list.</p>
                        </div>
                        <div class="tw-field">
                            <label class="tw-label" for="password">Password</label>
                            <input type="password" id="password" name="password" class="tw-input" required=""
                                   autocomplete="new-password">
                        </div>
                        <div class="tw-field">
                            <label class="tw-label" for="confirm">Confirm password</label>
                            <input type="password" id="confirm" name="confirm" class="tw-input" required=""
                                   autocomplete="new-password">
                            <p class="tw-help">Type the same password again.</p>
                        </div>
                        <input type="hidden" name="_csrf" value="{{token}}">
                        <button class="tw-btn tw-btn--block" type="submit">Create account</button>
                    </form>
                </div>
            </section>
        </div>
    </main>
    <div class="footer">
    </div>
</div>
<script src="/js/jQuery.js"></script>
<script src="/general.js"></script>
<script src="validation.js"></script>
</body>
</html>
